{
  "title": "POS 4-72 — Auditoría",
  "uid": "pos472-auditoria",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "America/Bogota",
  "tags": ["pos472", "auditoria"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Eventos (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "pos472-pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{
        "refId": "A",
        "rawQuery": true,
        "rawSql": "SELECT COUNT(*) AS value FROM auditorias WHERE created_at > NOW() - INTERVAL '24 hours'",
        "format": "table"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errores (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "pos472-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
      },
      "targets": [{
        "refId": "A",
        "rawQuery": true,
        "rawSql": "SELECT COUNT(*) AS value FROM auditorias WHERE resultado = 'ERROR' AND created_at > NOW() - INTERVAL '24 hours'",
        "format": "table"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Usuarios activos hoy",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "pos472-pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [{
        "refId": "A",
        "rawQuery": true,
        "rawSql": "SELECT COUNT(DISTINCT usuario_id) AS value FROM auditorias WHERE created_at > NOW() - INTERVAL '24 hours' AND usuario_id IS NOT NULL",
        "format": "table"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tasa de error (%)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "pos472-pg" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] }
      },
      "targets": [{
        "refId": "A",
        "rawQuery": true,
        "rawSql": "SELECT ROUND(100.0 * SUM(CASE WHEN resultado = 'ERROR' THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 2) AS value FROM auditorias WHERE created_at > NOW() - INTERVAL '24 hours'",
        "format": "table"
      }]
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Eventos por acción",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "pos472-pg" },
      "targets": [{
        "refId": "A",
        "rawQuery": true,
        "rawSql": "SELECT accion, COUNT(*) AS total FROM auditorias WHERE created_at > NOW() - INTERVAL '24 hours' GROUP BY accion ORDER BY total DESC",
        "format": "table"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "OK vs ERROR",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "postgres", "uid": "pos472-pg" },
      "options": { "pieType": "donut" },
      "targets": [{
        "refId": "A",
        "rawQuery": true,
        "rawSql": "SELECT resultado, COUNT(*) AS total FROM auditorias WHERE created_at > NOW() - INTERVAL '24 hours' GROUP BY resultado",
        "format": "table"
      }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Eventos por minuto",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "pos472-pg" },
      "targets": [{
        "refId": "A",
        "rawQuery": true,
        "rawSql": "SELECT date_trunc('minute', created_at) AS time, COUNT(*) AS eventos, SUM(CASE WHEN resultado = 'ERROR' THEN 1 ELSE 0 END) AS errores FROM auditorias WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
        "format": "time_series"
      }]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Últimos eventos",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "postgres", "uid": "pos472-pg" },
      "options": { "sortBy": [{ "displayName": "created_at", "desc": true }] },
      "targets": [{
        "refId": "A",
        "rawQuery": true,
        "rawSql": "SELECT created_at, accion, entidad, entidad_id, resultado, usuario_id, ip_origen, trace_id, error_msg FROM auditorias WHERE $__timeFilter(created_at) ORDER BY created_at DESC LIMIT 100",
        "format": "table"
      }],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "trace_id" },
            "properties": [{
              "id": "links",
              "value": [{ "title": "Ver en Jaeger", "url": "http://localhost:16686/trace/${__value.raw}", "targetBlank": true }]
            }]
          },
          { "matcher": { "id": "byName", "options": "resultado" }, "properties": [{ "id": "custom.width", "value": 80 }] },
          { "matcher": { "id": "byName", "options": "error_msg" }, "properties": [{ "id": "custom.width", "value": 300 }] }
        ]
      }
    }
  ]
}
