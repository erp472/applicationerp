{
  "title": "4-72 POS — Feature Flags",
  "uid": "pos472-feature-flags",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "America/Bogota",
  "tags": ["pos472", "feature-flags"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Flags",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "uid": "pos472_pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "unit": "short" } },
      "targets": [{ "rawSql": "SELECT COUNT(*) AS value FROM feature_flags", "format": "table" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Activos",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "uid": "pos472_pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "short" } },
      "targets": [{ "rawSql": "SELECT COUNT(*) AS value FROM feature_flags WHERE activofeature_flags = true", "format": "table" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Inactivos",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "uid": "pos472_pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "short" } },
      "targets": [{ "rawSql": "SELECT COUNT(*) AS value FROM feature_flags WHERE activofeature_flags = false", "format": "table" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Modificados (7d)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "uid": "pos472_pg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "yellow" }, "unit": "short" } },
      "targets": [{ "rawSql": "SELECT COUNT(*) AS value FROM feature_flags WHERE updated_atfeature_flags > NOW() - INTERVAL '7 days'", "format": "table" }]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Distribución por entorno",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "uid": "pos472_pg" },
      "options": { "pieType": "donut", "legendDisplayMode": "table", "placement": "right" },
      "targets": [{
        "rawSql": "SELECT entornofeature_flags AS entorno, COUNT(*) AS total FROM feature_flags GROUP BY entornofeature_flags ORDER BY total DESC",
        "format": "table"
      }]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Activos vs Inactivos por entorno",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "uid": "pos472_pg" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "targets": [{
        "rawSql": "SELECT entornofeature_flags AS entorno, SUM(CASE WHEN activofeature_flags THEN 1 ELSE 0 END) AS activos, SUM(CASE WHEN NOT activofeature_flags THEN 1 ELSE 0 END) AS inactivos FROM feature_flags GROUP BY entornofeature_flags ORDER BY entorno",
        "format": "table"
      }]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Detalle completo de feature flags",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "uid": "pos472_pg" },
      "options": { "footer": { "show": false }, "showHeader": true, "cellHeight": "sm", "sortBy": [{ "displayName": "Código", "desc": false }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Activo" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "mappings", "value": [{ "type": "value", "options": { "true": { "text": "Activo", "color": "green" }, "false": { "text": "Inactivo", "color": "red" } } }] }
          ] },
          { "matcher": { "id": "byName", "options": "Código" }, "properties": [{ "id": "custom.width", "value": 220 }] },
          { "matcher": { "id": "byName", "options": "Última modificación" }, "properties": [{ "id": "custom.width", "value": 180 }] }
        ]
      },
      "targets": [{
        "rawSql": "SELECT codigofeature_flags AS \"Código\", COALESCE(descripcionfeature_flags, '-') AS \"Descripción\", entornofeature_flags AS \"Entorno\", activofeature_flags::text AS \"Activo\", to_char(updated_atfeature_flags, 'DD/MM/YYYY HH24:MI') AS \"Última modificación\" FROM feature_flags ORDER BY activofeature_flags DESC, codigofeature_flags ASC",
        "format": "table"
      }]
    }
  ]
}
