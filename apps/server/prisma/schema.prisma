  conveniosSucursal ConvenioSucursal[]
  recaudos          Recaudo[]

  @@map("convenios_recaudo")
}

model ConvenioSucursal {
  sucursales_idsucursales               Int
  convenios_recaudo_idconvenios_recaudo Int
  activoconvenios_sucursal              Boolean @default(true)

  sucursal         Sucursal        @relation(fields: [sucursales_idsucursales], references: [idsucursales])
  convenioRecaudo  ConvenioRecaudo @relation(fields: [convenios_recaudo_idconvenios_recaudo], references: [idconvenios_recaudo])

  @@id([sucursales_idsucursales, convenios_recaudo_idconvenios_recaudo])
