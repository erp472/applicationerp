generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum RolUsuario {
  CAJERO
  ADMINISTRATIVO
  TESORERIA
  INVENTARIOS
  SUPERVISOR_REGIONAL
  ADMIN_NACIONAL
  ADMIN_SISTEMA
}

enum AuditAccion {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PRINT
  EXPORT
}

enum AuditResultado {
  OK
  ERROR
}

// ── Jerarquía comercial ───────────────────────────────────────────────────────

model Sucursal {
  id        String    @id @default(uuid()) @db.Uuid
  codigo    String    @unique @db.VarChar(20)
  nombre    String    @db.VarChar(120)
  ciudad    String?   @db.VarChar(80)
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  usuarios           Usuario[]
  equiposAutorizados EquipoAutorizado[]

  @@map("sucursales")
}

// ── RBAC: Roles, Módulos, Permisos ────────────────────────────────────────────

model Rol {
  id          String   @id @default(uuid()) @db.Uuid
  nombre      String   @unique @db.VarChar(80)
  descripcion String?  @db.VarChar(200)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permisos RolPermiso[]

  @@map("roles")
}

model Modulo {
  id          String   @id @default(uuid()) @db.Uuid
  nombre      String   @unique @db.VarChar(80)
  descripcion String?  @db.VarChar(200)
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permisos Permiso[]

  @@map("modulos")
}

model Permiso {
  id          String   @id @default(uuid()) @db.Uuid
  nombre      String   @db.VarChar(80)
  descripcion String?  @db.VarChar(200)
  activo      Boolean  @default(true)
  moduloId    String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modulo Modulo     @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  roles  RolPermiso[]

  @@unique([moduloId, nombre])
  @@index([moduloId])
  @@map("permisos")
}

model RolPermiso {
  id        String   @id @default(uuid()) @db.Uuid
  rolId     String   @db.Uuid
  permisoId String   @db.Uuid
  createdAt DateTime @default(now())

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@unique([rolId, permisoId])
  @@index([rolId])
  @@map("roles_permisos")
}

// ── Usuarios y dispositivos ───────────────────────────────────────────────────

model Usuario {
  id           String     @id @default(uuid()) @db.Uuid
  nombre       String     @db.VarChar(120)
  email        String     @unique @db.VarChar(120)
  passwordHash String     @db.VarChar(255)
  rol          RolUsuario
  sucursalId   String?    @db.Uuid
  activo       Boolean    @default(true)
  ultimoLogin  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  sucursal           Sucursal?          @relation(fields: [sucursalId], references: [id])
  equiposAutorizados EquipoAutorizado[]

  @@index([email])
  @@index([rol])
  @@index([sucursalId])
  @@map("usuarios")
}

model EquipoAutorizado {
  id         String    @id @default(uuid()) @db.Uuid
  macAddress String    @db.VarChar(17)
  sucursalId String    @db.Uuid
  usuarioId  String?   @db.Uuid
  nombre     String?   @db.VarChar(120)
  activo     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  sucursal Sucursal  @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  usuario  Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@unique([macAddress, sucursalId, usuarioId])
  @@index([usuarioId])
  @@map("equipos_autorizados")
}

// ── Feature Flags ─────────────────────────────────────────────────────────────

enum EntornoFeatureFlag {
  all
  dev
  staging
  prod
}

model FeatureFlag {
  id          String             @id @default(uuid()) @db.Uuid
  codigo      String             @unique @db.VarChar(100)
  descripcion String?            @db.VarChar(200)
  activo      Boolean            @default(false)
  entorno     EntornoFeatureFlag @default(all)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("feature_flags")
}

// ── Auditoría ─────────────────────────────────────────────────────────────────

model Auditoria {
  id            String         @id @default(uuid()) @db.Uuid
  trace_id      String?        @db.VarChar(32)
  span_id       String?        @db.VarChar(16)
  usuario_id    String?        @db.Uuid
  accion        AuditAccion
  entidad       String         @db.VarChar(64)
  entidad_id    String?        @db.VarChar(64)
  datos_antes   Json?
  datos_despues Json?
  ip_origen     String?        @db.VarChar(45)
  resultado     AuditResultado @default(OK)
  error_msg     String?
  created_at    DateTime       @default(now())

  @@index([trace_id])
  @@index([usuario_id, created_at])
  @@index([entidad, entidad_id])
  @@index([created_at])
  @@map("auditorias")
}
