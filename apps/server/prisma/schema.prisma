// 21. FEATURE FLAGS
// ══════════════════════════════════════════════════════════════════════════════

model FeatureFlag {
  idfeature_flags          Int                     @id @default(autoincrement())
  codigofeature_flags      String                  @unique @db.VarChar(100)
  descripcionfeature_flags String?                 @db.VarChar(200)
  activofeature_flags      Boolean                 @default(false)
  entornofeature_flags     entorno_feature_flag    @default(all)
  plataformafeature_flags  plataforma_feature_flag @default(all)
  created_atfeature_flags  DateTime                @default(now()) @db.Timestamptz(6)
  updated_atfeature_flags  DateTime                @default(now()) @db.Timestamptz(6)

