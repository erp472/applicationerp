// ══════════════════════════════════════════════════════════════════════════════
// 0. GEO: PAÍSES, DEPARTAMENTOS, CIUDADES
// ══════════════════════════════════════════════════════════════════════════════

model Pais {
  idpaises     Int     @id
  nombrepaises String  @db.VarChar(100)
  iso2         String? @db.VarChar(2)
  iso3         String? @db.VarChar(3)
  phonecode    String? @db.VarChar(10)
  region       String? @db.VarChar(50)
  activo       Boolean @default(true)

  departamentos Departamento[]
  sucursales    Sucursal[]
  usuarios      Usuario[]

  @@map("paises")
}

model Departamento {
  iddepartamentos     Int     @id
  paises_idpaises     Int
  nombredepartamentos String  @db.VarChar(100)
  activo              Boolean @default(true)

  pais       Pais       @relation(fields: [paises_idpaises], references: [idpaises])
  ciudades   Ciudad[]
  sucursales Sucursal[]
  usuarios   Usuario[]

  @@map("departamentos")
}

model Ciudad {
  idciudades                    Int     @id
  departamentos_iddepartamentos Int
  nombreciudades                String  @db.VarChar(100)
  activo                        Boolean @default(true)

  departamento Departamento @relation(fields: [departamentos_iddepartamentos], references: [iddepartamentos])
  sucursales   Sucursal[]
  usuarios     Usuario[]

  @@map("ciudades")
}

// ══════════════════════════════════════════════════════════════════════════════
// 1. JERARQUÍA COMERCIAL
// ══════════════════════════════════════════════════════════════════════════════

model Comercio {
  idcomercios         Int       @id @default(autoincrement())
  codigocomercios     String    @unique @db.VarChar(20)
  nombrecomercios     String    @db.VarChar(200)
  nitcomercios        String    @unique @db.VarChar(30)
  activocomercios     Boolean   @default(true)
  created_atcomercios DateTime  @default(now()) @db.Timestamptz(6)
  deleted_atcomercios DateTime? @db.Timestamptz(6)

  regionales   Regional[]
  tiposCliente TipoCliente[]
  clientes     Cliente[]

  @@map("comercios")
}

model Regional {
  idregionales          Int       @id @default(autoincrement())
  comercios_idcomercios Int
  codigoregionales      String    @unique @db.VarChar(20)
  nombreregionales      String    @db.VarChar(200)
  activoregionales      Boolean   @default(true)
  created_atregionales  DateTime  @default(now()) @db.Timestamptz(6)
  deleted_atregionales  DateTime? @db.Timestamptz(6)

  comercio   Comercio   @relation(fields: [comercios_idcomercios], references: [idcomercios])
  sucursales Sucursal[]

  @@map("regionales")
}

model Sucursal {
  idsucursales                  Int           @id @default(autoincrement())
  regionales_idregionales       Int
  paises_idpaises               Int?
  departamentos_iddepartamentos Int?
  ciudades_idciudades           Int?
  codigosucursales              String        @unique @db.VarChar(20)
  nombresucursales              String        @db.VarChar(200)
  direccionsucursales           String?
  tiposucursales                tipo_sucursal @default(unipersonal)
  telefonosucursales            String?       @db.VarChar(20)
  emailsucursales               String?       @db.VarChar(200)
  horario_aperturasucursales    DateTime?     @db.Time(6)
  horario_cierresucursales      DateTime?     @db.Time(6)
  activosucursales              Boolean       @default(true)
  created_atsucursales          DateTime      @default(now()) @db.Timestamptz(6)
  updated_atsucursales          DateTime      @default(now()) @db.Timestamptz(6)
  deleted_atsucursales          DateTime?     @db.Timestamptz(6)

  regional     Regional      @relation(fields: [regionales_idregionales], references: [idregionales])
  pais         Pais?         @relation(fields: [paises_idpaises], references: [idpaises])
  departamento Departamento? @relation(fields: [departamentos_iddepartamentos], references: [iddepartamentos])
  ciudad       Ciudad?       @relation(fields: [ciudades_idciudades], references: [idciudades])
  equiposAutorizados    EquipoAutorizado[]
  documentos            Documento[]
  usuarios              Usuario[]
  productosSucursal     ProductoSucursal[]
  serviciosSucursal     ServicioSucursal[]
  cajasPadres           CajaPadre[]
  cajas                 Caja[]
  inventarioSucursal    InventarioSucursal[]
  movimientosInventario MovimientoInventario[]
  ordenesInventario     OrdenInventario[]
  sacas                 Saca[]
  apartadosPostales     ApartadoPostal[]
  giros                 Giro[]                 @relation("GiroSucursal")
  girosBeneficiario     Giro[]                 @relation("GiroBeneficiario")
  recaudos              Recaudo[]
  conveniosSucursal     ConvenioSucursal[]
  alertas               Alerta[]
  envios                Envio[]
  enviosMasivos         EnvioMasivo[]
  eventosAuditoria      EventoAuditoria[]

  @@map("sucursales")
}

model EquipoAutorizado {
  idequipos_autorizados                Int                       @id @default(autoincrement())
  sucursales_idsucursales              Int
  mac_addressequipos_autorizados       String                    @db.VarChar(30)
  nombreequipos_autorizados            String?                   @db.VarChar(100)
  sistema_operativoequipos_autorizados sistema_operativo_equipo?
  activoequipos_autorizados            Boolean                   @default(true)
  created_atequipos_autorizados        DateTime                  @default(now()) @db.Timestamptz(6)
  deleted_atequipos_autorizados        DateTime?                 @db.Timestamptz(6)

  sucursal Sucursal @relation(fields: [sucursales_idsucursales], references: [idsucursales])

  @@unique([mac_addressequipos_autorizados, sucursales_idsucursales], name: "equipos_autorizados_mac_sucursal_key")
  @@map("equipos_autorizados")
}

model Documento {
  iddocumentos            Int       @id @default(autoincrement())
  sucursales_idsucursales Int
  descripciondocumentos   String    @db.VarChar(100)
  prefijodocumentos       String    @db.VarChar(10)
  desdedocumentos         Int
  hastadocumentos         Int
  ultimodocumentos        Int       @default(0)
  resoluciondocumentos    String?   @db.VarChar(80)
  activodocumentos        Boolean   @default(true)
  created_atdocumentos    DateTime  @default(now()) @db.Timestamptz(6)
  deleted_atdocumentos    DateTime? @db.Timestamptz(6)

  sucursal Sucursal @relation(fields: [sucursales_idsucursales], references: [idsucursales])
  ventas   Venta[]

  @@map("documentos")
}

// ══════════════════════════════════════════════════════════════════════════════
// 2. ROLES Y PERMISOS
// ══════════════════════════════════════════════════════════════════════════════

model Rol {
  idroles         Int       @id @default(autoincrement())
  codigoroles     String    @unique @db.VarChar(40)
  nombreroles     String    @db.VarChar(100)
  activoroles     Boolean   @default(true)
  created_atroles DateTime  @default(now()) @db.Timestamptz(6)
  deleted_atroles DateTime? @db.Timestamptz(6)

  usuarios      Usuario[]
  rolesPermisos RolPermiso[]
  featureFlagsRoles FeatureFlagRol[]

  @@map("roles")
}

model Permiso {
  idpermisos          Int       @id @default(autoincrement())
  codigopermisos      String    @unique @db.VarChar(100)
  descripcionpermisos String?   @db.VarChar(200)
  modulopermisos      String    @db.VarChar(50)
  deleted_atpermisos  DateTime? @db.Timestamptz(6)

  rolesPermisos RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  roles_idroles       Int
  permisos_idpermisos Int

  rol     Rol     @relation(fields: [roles_idroles], references: [idroles], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisos_idpermisos], references: [idpermisos], onDelete: Cascade)

  @@id([roles_idroles, permisos_idpermisos])
  @@map("roles_permisos")
}

// ══════════════════════════════════════════════════════════════════════════════
// 3. USUARIOS
// ══════════════════════════════════════════════════════════════════════════════

model Usuario {
  idusuarios                    Int       @id @default(autoincrement())
  sucursales_idsucursales       Int?
  roles_idroles                 Int
  paises_idpaises               Int?
  departamentos_iddepartamentos Int?
  ciudades_idciudades           Int?
  nombreusuarios                String    @db.VarChar(200)
  emailusuarios                 String    @unique @db.VarChar(200)
  password_hashusuarios         String    @db.VarChar(500)
  telefonousuarios              String?                  @db.VarChar(20)
  tipo_documentousuarios        tipo_documento_identidad?
  numero_documentousuarios      String?                  @db.VarChar(30)
  activousuarios                Boolean   @default(true)
  ultimo_loginusuarios          DateTime? @db.Timestamptz(6)
  created_atusuarios            DateTime  @default(now()) @db.Timestamptz(6)
  updated_atusuarios            DateTime  @default(now()) @db.Timestamptz(6)
  deleted_atusuarios            DateTime? @db.Timestamptz(6)

  sucursal     Sucursal?     @relation(fields: [sucursales_idsucursales], references: [idsucursales])
  rol          Rol           @relation(fields: [roles_idroles], references: [idroles])
  pais         Pais?         @relation(fields: [paises_idpaises], references: [idpaises])
  departamento Departamento? @relation(fields: [departamentos_iddepartamentos], references: [iddepartamentos])
  ciudad       Ciudad?       @relation(fields: [ciudades_idciudades], references: [idciudades])

  sesionesApertura        SesionCaja[]          @relation("SesionCajaApertura")
  sesionesCierre          SesionCaja[]          @relation("SesionCajaCierre")
  sesionesCajeroAsignado  SesionCaja[]          @relation("SesionCajaCajeroAsignado")
  consignaciones          Consignacion[]        @relation("ConsignacionUsuario")
  consignacionesAprobadas Consignacion[]        @relation("ConsignacionAprobador")
  reposicionesCaja        ReposicionCaja[]
  ventas                  Venta[]
  envios                  Envio[]
  enviosMasivos           EnvioMasivo[]
  sacas                   Saca[]
  giros                   Giro[]
  recaudos                Recaudo[]
  movimientosInventario   MovimientoInventario[]
  ordenesCreadas          OrdenInventario[]     @relation("OrdenInventarioCreador")
  ordenesConfirmadas      OrdenInventario[]     @relation("OrdenInventarioConfirmador")
  alertasCreadas          Alerta[]              @relation("AlertaCreador")
  alertasResueltas        Alerta[]              @relation("AlertaResolutor")
  anulacionesSolicitadas   Anulacion[]           @relation("AnulacionSolicitante")
  anulacionesAprobadas     Anulacion[]           @relation("AnulacionAprobador")
  diferenciasComoCustodio  DiferenciaCaja[]      @relation("DiferenciaCustodio")
  diferenciasComoAprobador DiferenciaCaja[]      @relation("DiferenciaAprobador")
  eventosAuditoria         EventoAuditoria[]
  consultasInspektor      ConsultaInspektor[]
  featureFlagsUsuarios    FeatureFlagUsuario[]

  @@index([sucursales_idsucursales])
  @@map("usuarios")
}

// ══════════════════════════════════════════════════════════════════════════════
// 4. CATÁLOGO: TIPOS DE CLIENTE
// ══════════════════════════════════════════════════════════════════════════════

model TipoCliente {
  idtipos_cliente                   Int       @id @default(autoincrement())
  comercios_idcomercios             Int?
  codigotipos_cliente               String    @unique @db.VarChar(30)
  nombretipos_cliente               String    @db.VarChar(100)
  descuento_porcentajetipos_cliente Decimal   @default(0) @db.Decimal(5, 2)
  aplica_estampillastipos_cliente   Boolean   @default(false)
  aplica_giros_sisbentipos_cliente  Boolean   @default(false)
  activotipos_cliente               Boolean   @default(true)
  vigencia_iniciotipos_cliente      DateTime? @db.Date
  vigencia_fintipos_cliente         DateTime? @db.Date
  created_attipos_cliente           DateTime  @default(now()) @db.Timestamptz(6)
  deleted_attipos_cliente           DateTime? @db.Timestamptz(6)

  comercio        Comercio?        @relation(fields: [comercios_idcomercios], references: [idcomercios])
  clientes        Cliente[]
  tarifasProducto TarifaProducto[]
  tarifasServicio TarifaServicio[]

  @@map("tipos_cliente")
}

// ══════════════════════════════════════════════════════════════════════════════
// 5. CATÁLOGO: PRODUCTOS FÍSICOS
// ══════════════════════════════════════════════════════════════════════════════

model Producto {
  idproductos                 Int          @id @default(autoincrement())
  codigoproductos             String       @unique @db.VarChar(50)
  nombreproductos             String       @db.VarChar(200)
  descripcionproductos        String?
  serieproductos              String?      @db.VarChar(100)
  tipoproductos               tipo_producto
  precioproductos             Decimal      @db.Decimal(18, 2)
  precio_sin_taxproductos     Decimal?     @db.Decimal(18, 2)
  porcentaje_taxproductos     Decimal      @default(0) @db.Decimal(5, 2)
  pesoproductos               Decimal?     @db.Decimal(8, 3)
  factor_volumetricoproductos Decimal?     @db.Decimal(8, 4)
  imagen_urlproductos              String?      @db.VarChar(500)
  cantidad_minima_ventaproductos   Int?
  cantidad_maxima_ventaproductos   Int?
  activoproductos             Boolean      @default(true)
  created_atproductos         DateTime     @default(now()) @db.Timestamptz(6)
  updated_atproductos         DateTime     @default(now()) @db.Timestamptz(6)
  deleted_atproductos         DateTime?    @db.Timestamptz(6)

  productosSucursal       ProductoSucursal[]
  tarifasProducto         TarifaProducto[]
  tarifasEspecialCantidad TarifaEspecialCantidad[]
  ventasDetalle           VentaDetalle[]
  enviosItems             EnvioItem[]
  inventarioSucursal      InventarioSucursal[]
  movimientosInventario   MovimientoInventario[]
  ordenesItems            OrdenInventarioItem[]

  @@map("productos")
}

model ProductoSucursal {
  sucursales_idsucursales  Int
  productos_idproductos    Int
  activoproductos_sucursal Boolean @default(true)

  sucursal Sucursal @relation(fields: [sucursales_idsucursales], references: [idsucursales])
  producto Producto @relation(fields: [productos_idproductos], references: [idproductos])

  @@id([sucursales_idsucursales, productos_idproductos])
  @@map("productos_sucursal")
}

model TarifaProducto {
  idtarifas_producto              Int       @id @default(autoincrement())
  productos_idproductos           Int
  tipos_cliente_idtipos_cliente   Int
  preciotarifas_producto          Decimal   @db.Decimal(18, 2)
  activotarifas_producto          Boolean   @default(true)
  vigencia_iniciotarifas_producto DateTime? @db.Date
  vigencia_fintarifas_producto    DateTime? @db.Date
  created_attarifas_producto      DateTime  @default(now()) @db.Timestamptz(6)
  deleted_attarifas_producto      DateTime? @db.Timestamptz(6)

  producto    Producto    @relation(fields: [productos_idproductos], references: [idproductos])
  tipoCliente TipoCliente @relation(fields: [tipos_cliente_idtipos_cliente], references: [idtipos_cliente])

  @@unique([productos_idproductos, tipos_cliente_idtipos_cliente, vigencia_iniciotarifas_producto])
  @@map("tarifas_producto")
}

model TarifaEspecialCantidad {
  idtarifas_especial_cantidad    Int       @id @default(autoincrement())
  productos_idproductos          Int
  min_cantidadtarifas_especial   Int
  max_cantidadtarifas_especial   Int?
  preciotarifas_especial         Decimal   @db.Decimal(18, 2)
  activotarifas_especial         Boolean   @default(true)
  created_attarifas_especial     DateTime  @default(now()) @db.Timestamptz(6)
  deleted_attarifas_especial     DateTime? @db.Timestamptz(6)

  producto Producto @relation(fields: [productos_idproductos], references: [idproductos])

  @@unique([productos_idproductos, min_cantidadtarifas_especial])
  @@index([productos_idproductos, activotarifas_especial], map: "idx_tarifas_especial_lookup")
  @@map("tarifas_especial_cantidad")
}

// ══════════════════════════════════════════════════════════════════════════════
// 6. CATÁLOGO: SERVICIOS DE ENVÍO
// ══════════════════════════════════════════════════════════════════════════════

model Servicio {
  idservicios                       Int                 @id @default(autoincrement())
  codigoservicios                   String              @unique @db.VarChar(50)
  nombreservicios                   String              @db.VarChar(200)
  descripcionservicios              String?
  tiposervicios                     tipo_servicio_envio
  requiere_estampillaservicios      Boolean             @default(false)
  requiere_dimensionesservicios     Boolean             @default(false)
  requiere_valor_declaradoservicios Boolean             @default(false)
  peso_maximo_kgservicios           Decimal?            @db.Decimal(8, 3)
  factor_volumetricoservicios       Int                 @default(2500)
  tiempo_entrega_diasservicios      Int?
  codigo_sigmaservicios             String?             @db.VarChar(50)
  prefijo_guia_servicios            String?             @db.VarChar(5)
  tarifa_certificacionservicios     Decimal?            @db.Decimal(18, 2)
  minimo_seguro_postalservicios     Decimal?            @db.Decimal(18, 2)
  alto_max_cmservicios              Decimal?            @db.Decimal(8, 1)
  ancho_max_cmservicios             Decimal?            @db.Decimal(8, 1)
  largo_max_cmservicios             Decimal?            @db.Decimal(8, 1)
  activoservicios                   Boolean             @default(true)
  created_atservicios               DateTime            @default(now()) @db.Timestamptz(6)
  deleted_atservicios               DateTime?           @db.Timestamptz(6)

  serviciosSucursal ServicioSucursal[]
  tarifasServicio   TarifaServicio[]
  envios            Envio[]
  enviosMasivos     EnvioMasivo[]

  @@map("servicios")
}

model ServicioSucursal {
  sucursales_idsucursales  Int
  servicios_idservicios    Int
  activoservicios_sucursal Boolean @default(true)

  sucursal Sucursal @relation(fields: [sucursales_idsucursales], references: [idsucursales])
  servicio Servicio @relation(fields: [servicios_idservicios], references: [idservicios])

  @@id([sucursales_idsucursales, servicios_idservicios])
  @@map("servicios_sucursal")
}

model TarifaServicio {
  idtarifas_servicio                    Int       @id @default(autoincrement())
  servicios_idservicios                 Int
  tipos_cliente_idtipos_cliente         Int?
  pais_destinotarifas_servicio          String    @default("CO") @db.VarChar(5)
  ciudad_destinotarifas_servicio        String?   @db.VarChar(100)
  peso_min_kgtarifas_servicio           Decimal   @default(0) @db.Decimal(8, 3)
  peso_max_kgtarifas_servicio           Decimal?  @db.Decimal(8, 3)
  tarifatarifas_servicio                Decimal   @db.Decimal(18, 2)
  tarifa_kg_adicionaltarifas_servicio   Decimal?  @db.Decimal(18, 2)
  activatarifas_servicio                Boolean   @default(true)
  fecha_vigencia_iniciotarifas_servicio DateTime? @db.Date
  fecha_vigencia_fintarifas_servicio    DateTime? @db.Date
  created_attarifas_servicio            DateTime  @default(now()) @db.Timestamptz(6)
  deleted_attarifas_servicio            DateTime? @db.Timestamptz(6)

  servicio    Servicio     @relation(fields: [servicios_idservicios], references: [idservicios])
  tipoCliente TipoCliente? @relation(fields: [tipos_cliente_idtipos_cliente], references: [idtipos_cliente])

  @@index([servicios_idservicios, activatarifas_servicio], map: "idx_tarifas_servicio_lookup")
  @@map("tarifas_servicio")
}

// ══════════════════════════════════════════════════════════════════════════════
// 7. CLIENTES
// ══════════════════════════════════════════════════════════════════════════════

model Cliente {
  idclientes                    Int                      @id @default(autoincrement())
  comercios_idcomercios         Int?
  tipo_documentoclientes        tipo_documento_identidad
  numero_documentoclientes      String                   @db.VarChar(30)
  nombreclientes                String                   @db.VarChar(150)
  apellidoclientes              String?                  @db.VarChar(150)
  emailclientes                 String?                  @db.VarChar(200)
  telefonoclientes              String?                  @db.VarChar(20)
  direccionclientes             String?
  ciudadclientes                String?                  @db.VarChar(100)
  codigo_postalclientes         String?                  @db.VarChar(20)
  tipos_cliente_idtipos_cliente Int?
  nivel_sisbenclientes          Int?
  envios_sisben_anoclientes     Int                      @default(0)
  saldo_a_favclientes           Decimal                  @default(0) @db.Decimal(18, 2)
  activoclientes                Boolean                  @default(true)
  created_atclientes            DateTime                 @default(now()) @db.Timestamptz(6)
  updated_atclientes            DateTime                 @default(now()) @db.Timestamptz(6)
  deleted_atclientes            DateTime?                @db.Timestamptz(6)

  comercio    Comercio?    @relation(fields: [comercios_idcomercios], references: [idcomercios])
  tipoCliente TipoCliente? @relation(fields: [tipos_cliente_idtipos_cliente], references: [idtipos_cliente])

  ventas                Venta[]
  envios                Envio[]
  enviosMasivos         EnvioMasivo[]
  apartadosPostales     ApartadoPostal[]
  giros                 Giro[]
  recaudos              Recaudo[]
  facturas              Factura[]
  direccionesFrecuentes DireccionFrecuente[]

  @@unique([tipo_documentoclientes, numero_documentoclientes])
  @@index([tipo_documentoclientes, numero_documentoclientes], map: "idx_clientes_doc")
  @@map("clientes")
}

model DireccionFrecuente {
  iddireccionesfrecuentes       Int      @id @default(autoincrement())
  clientes_idclientes           Int
  roldireccionesfrecuentes      String   @db.VarChar(20)
  nombredireccionesfrecuentes   String   @db.VarChar(300)
  empresadireccionesfrecuentes  String?  @db.VarChar(300)
  telefonodirfrecuentes         String?  @db.VarChar(20)
  emaildirfrecuentes            String?  @db.VarChar(200)
  direcciondirfrecuentes        String?
  ciudaddirfrecuentes           String?  @db.VarChar(100)
  departamentodirfrecuentes     String?  @db.VarChar(100)
  paisdirfrecuentes             String   @default("CO") @db.VarChar(5)
  codigo_postaldirfrecuentes    String?  @db.VarChar(20)
  documentodirfrecuentes        String?  @db.VarChar(50)
  usosdirfrecuentes             Int      @default(1)
  ultimo_usodirfrecuentes       DateTime @default(now()) @db.Timestamptz(6)
  created_atdirfrecuentes       DateTime @default(now()) @db.Timestamptz(6)

  cliente Cliente @relation(fields: [clientes_idclientes], references: [idclientes], onDelete: Cascade)

  @@index([clientes_idclientes, roldireccionesfrecuentes], map: "idx_dir_frecuentes_cliente_rol")
  @@index([documentodirfrecuentes, roldireccionesfrecuentes], map: "idx_dir_frecuentes_doc_rol")
  @@map("direcciones_frecuentes")
}

// ══════════════════════════════════════════════════════════════════════════════
// 8. CAJAS
// ══════════════════════════════════════════════════════════════════════════════

model CajaPadre {
  idcajas_padres           Int       @id @default(autoincrement())
  sucursales_idsucursales  Int
  nombrecajas_padres       String    @db.VarChar(100)
  base_generalcajas_padres Decimal   @default(0) @db.Decimal(18, 2)
  hora_resetcajas_padres   DateTime? @db.Time(6)
  created_atcajas_padres   DateTime  @default(now()) @db.Timestamptz(6)
  deleted_atcajas_padres   DateTime? @db.Timestamptz(6)

  sucursal Sucursal @relation(fields: [sucursales_idsucursales], references: [idsucursales])
  cajas    Caja[]

  @@map("cajas_padres")
}

model Caja {
  idcajas                     Int       @id @default(autoincrement())
  sucursales_idsucursales     Int
  cajas_padres_idcajas_padres Int?
  codigocajas                 String    @db.VarChar(20)
  nombrecajas                 String    @db.VarChar(100)
  tipocajas                   tipo_caja
  base_diacajas               Decimal   @default(0) @db.Decimal(18, 2)
  limite_alertacajas          Decimal?  @db.Decimal(18, 2)
  t_targetcajas               Decimal?  @db.Decimal(18, 2)
  activocajas                 Boolean   @default(true)
  created_atcajas             DateTime  @default(now()) @db.Timestamptz(6)
  deleted_atcajas             DateTime? @db.Timestamptz(6)

  sucursal   Sucursal   @relation(fields: [sucursales_idsucursales], references: [idsucursales])
  cajaPadre  CajaPadre? @relation(fields: [cajas_padres_idcajas_padres], references: [idcajas_padres])
  sesiones   SesionCaja[]

  @@unique([codigocajas, sucursales_idsucursales])
  @@map("cajas")
}

model SesionCaja {
  idsesiones_caja              Int                @id @default(autoincrement())
  cajas_idcajas                Int
  usuarios_idusuarios_apertura          Int
  usuarios_idusuarios_cierre            Int?
  usuarios_idusuarios_cajero_asignado   Int?
  equipo_macsesiones_caja      String?            @db.VarChar(30)
  monto_aperturasesiones_caja  Decimal            @default(0) @db.Decimal(18, 2)
  monto_cierrasesiones_caja    Decimal?           @db.Decimal(18, 2)
  fecha_aperturasesiones_caja  DateTime           @default(now()) @db.Timestamptz(6)
  fecha_cierrasesiones_caja    DateTime?          @db.Timestamptz(6)
  cierre_forzadosesiones_caja           Boolean            @default(false)
  estadosesiones_caja                   estado_sesion_caja @default(abierta)
  observacionessesiones_caja            String?
  arqueo_denominacionessesiones_caja    Json?

  caja              Caja     @relation(fields: [cajas_idcajas], references: [idcajas])
  usuarioApertura   Usuario  @relation("SesionCajaApertura", fields: [usuarios_idusuarios_apertura], references: [idusuarios])
  usuarioCierre     Usuario? @relation("SesionCajaCierre", fields: [usuarios_idusuarios_cierre], references: [idusuarios])
  cajeroAsignado    Usuario? @relation("SesionCajaCajeroAsignado", fields: [usuarios_idusuarios_cajero_asignado], references: [idusuarios])

  movimientosCaja  MovimientoCaja[]
  consignaciones   Consignacion[]
  reposicionesOrigen  ReposicionCaja[] @relation("ReposicionOrigen")
  reposicionesDestino ReposicionCaja[] @relation("ReposicionDestino")
  diferencias      DiferenciaCaja[]
  ventas           Venta[]
  envios           Envio[]
  enviosMasivos    EnvioMasivo[]
  sacas            Saca[]
  apartadosPostales ApartadoPostal[]
  giros            Giro[]
  recaudos         Recaudo[]
  facturas         Factura[]

  @@index([cajas_idcajas, estadosesiones_caja], map: "idx_sesiones_caja_estado")
  @@map("sesiones_caja")
}

// ══════════════════════════════════════════════════════════════════════════════
// 9. MOVIMIENTOS DE CAJA
// ══════════════════════════════════════════════════════════════════════════════

model MovimientoCaja {
  idmovimientos_caja              Int                  @id @default(autoincrement())
  sesiones_caja_idsesiones_caja   Int
  tipomovimientos_caja            tipo_movimiento_caja
  montomovimientos_caja           Decimal              @db.Decimal(18, 2)
  medio_pagomovimientos_caja      medio_pago?
  referencia_idmovimientos_caja   Int?
  referencia_tipomovimientos_caja String?              @db.VarChar(50)
  descripcionmovimientos_caja     String?
  created_atmovimientos_caja      DateTime             @default(now()) @db.Timestamptz(6)

  sesionCaja SesionCaja @relation(fields: [sesiones_caja_idsesiones_caja], references: [idsesiones_caja])

  @@index([sesiones_caja_idsesiones_caja], map: "idx_mov_caja_sesion")
  @@map("movimientos_caja")
}

model Consignacion {
  idconsignaciones               Int                @id @default(autoincrement())
  sesiones_caja_idsesiones_caja  Int
  usuarios_idusuarios            Int
  medioconsignaciones            medio_consignacion
  banco_nombreconsignaciones     String?            @db.VarChar(100)
  tipo_cuentaconsignaciones      tipo_cuenta_bancaria?
  numero_cuentaconsignaciones    String?            @db.VarChar(30)
  montoconsignaciones            Decimal            @db.Decimal(18, 2)
  propositoconsignaciones        String?
  soporte_urlconsignaciones      String?            @db.VarChar(500)
  estadoconsignaciones           estado_aprobacion  @default(pendiente)
  usuarios_idusuarios_aprobador  Int?
  fecha_aprobacionconsignaciones DateTime?          @db.Timestamptz(6)
  created_atconsignaciones       DateTime           @default(now()) @db.Timestamptz(6)

  sesionCaja SesionCaja @relation(fields: [sesiones_caja_idsesiones_caja], references: [idsesiones_caja])
  usuario    Usuario    @relation("ConsignacionUsuario", fields: [usuarios_idusuarios], references: [idusuarios])
  aprobador  Usuario?   @relation("ConsignacionAprobador", fields: [usuarios_idusuarios_aprobador], references: [idusuarios])

  @@map("consignaciones")
}

model ReposicionCaja {
  idreposiciones_caja                   Int               @id @default(autoincrement())
  sesiones_caja_idsesiones_caja_origen  Int
  sesiones_caja_idsesiones_caja_destino Int
  montoreposiciones_caja                Decimal           @db.Decimal(18, 2)
  usuarios_idusuarios                   Int?
  estadoreposiciones_caja               estado_aprobacion @default(pendiente)
  motivoreposiciones_caja               String?
  codigo_remesareposiciones_caja        String?           @unique
  created_atreposiciones_caja           DateTime          @default(now()) @db.Timestamptz(6)

  sesionOrigen  SesionCaja @relation("ReposicionOrigen", fields: [sesiones_caja_idsesiones_caja_origen], references: [idsesiones_caja])
  sesionDestino SesionCaja @relation("ReposicionDestino", fields: [sesiones_caja_idsesiones_caja_destino], references: [idsesiones_caja])
  usuario       Usuario?   @relation(fields: [usuarios_idusuarios], references: [idusuarios])

  @@map("reposiciones_caja")
}

model DiferenciaCaja {
  iddiferencias_caja            Int               @id @default(autoincrement())
  sesiones_caja_idsesiones_caja Int
  tipo_diferencia               String            @db.VarChar(10)
  monto_diferencia              Decimal           @db.Decimal(18, 2)
  custodio_id                   Int?
  estado                        estado_aprobacion @default(pendiente)
  aprobador_id                  Int?
  observaciones                 String?
  created_at                    DateTime          @default(now()) @db.Timestamptz(6)

  sesionCaja SesionCaja @relation(fields: [sesiones_caja_idsesiones_caja], references: [idsesiones_caja])
  custodio   Usuario?   @relation("DiferenciaCustodio", fields: [custodio_id], references: [idusuarios])
  aprobador  Usuario?   @relation("DiferenciaAprobador", fields: [aprobador_id], references: [idusuarios])

  @@index([sesiones_caja_idsesiones_caja], map: "idx_diferencias_caja_sesion")
  @@map("diferencias_caja")
}

// ══════════════════════════════════════════════════════════════════════════════
// 10. VENTAS DE PRODUCTOS FÍSICOS
// ══════════════════════════════════════════════════════════════════════════════

model Venta {
  idventas                      Int          @id @default(autoincrement())
  sesiones_caja_idsesiones_caja Int
  usuarios_idusuarios           Int
  clientes_idclientes           Int?
  documentos_iddocumentos       Int?
  numero_docventas              String?      @db.VarChar(30)
  subtotalventas                Decimal      @default(0) @db.Decimal(18, 2)
  descuentoventas               Decimal      @default(0) @db.Decimal(18, 2)
  ivaventas                     Decimal      @default(0) @db.Decimal(18, 2)
  totalventas                   Decimal      @db.Decimal(18, 2)
  medio_pagoventas              medio_pago
  estadoventas                  estado_venta @default(activa)
  email_factura_ventas          String?      @db.VarChar(200)
  created_atventas              DateTime     @default(now()) @db.Timestamptz(6)
  updated_atventas              DateTime     @default(now()) @db.Timestamptz(6)

  sesionCaja SesionCaja @relation(fields: [sesiones_caja_idsesiones_caja], references: [idsesiones_caja])
  usuario    Usuario    @relation(fields: [usuarios_idusuarios], references: [idusuarios])
  cliente    Cliente?   @relation(fields: [clientes_idclientes], references: [idclientes])
  documento  Documento? @relation(fields: [documentos_iddocumentos], references: [iddocumentos])

  detalle             VentaDetalle[]
  envios              Envio[]
  apartadosPendientes ApartadoPostal[]

  @@index([sesiones_caja_idsesiones_caja], map: "idx_ventas_sesion")
  @@index([created_atventas], map: "idx_ventas_fecha")
  @@map("ventas")
}

model VentaDetalle {
  idventas_detalle              Int     @id @default(autoincrement())
  ventas_idventas               Int
  productos_idproductos         Int
  cantidadventas_detalle        Int
  precio_unitarioventas_detalle Decimal @db.Decimal(18, 2)
  descuentoventas_detalle       Decimal @default(0) @db.Decimal(18, 2)
  subtotalventas_detalle        Decimal @db.Decimal(18, 2)

  venta    Venta    @relation(fields: [ventas_idventas], references: [idventas], onDelete: Cascade)
  producto Producto @relation(fields: [productos_idproductos], references: [idproductos])

  @@index([ventas_idventas], map: "idx_ventas_detalle_venta")
  @@map("ventas_detalle")
}

// ══════════════════════════════════════════════════════════════════════════════
// 11. VENTAS DE ENVÍOS
// ══════════════════════════════════════════════════════════════════════════════

model Envio {
  idenvios                           Int         @id @default(autoincrement())
  numero_guiaenvios                  String      @unique @db.VarChar(50)
  tipoenvios                         tipo_envio
  es_correspondenciaenvios           Boolean     @default(false)
  sucursales_idsucursales            Int
  sesiones_caja_idsesiones_caja      Int?
  usuarios_idusuarios                Int
  clientes_idclientes                Int?
  servicios_idservicios              Int
  remitente_nombreenvios             String?     @db.VarChar(300)
  remitente_documentoenvios          String?     @db.VarChar(30)
  remitente_emailenvios              String?     @db.VarChar(200)
  remitente_telefonoenvios           String?     @db.VarChar(20)
  remitente_direccionenvios          String?
  remitente_ciudadenvios             String?     @db.VarChar(100)
  remitente_departamentoenvios       String?     @db.VarChar(100)
  remitente_codigo_postalenvios      String?     @db.VarChar(20)
  destinatario_nombreenvios          String?     @db.VarChar(300)
  destinatario_documentoenvios       String?     @db.VarChar(30)
  destinatario_tiene_docenvios       Boolean     @default(true)
  destinatario_emailenvios           String?     @db.VarChar(200)
  destinatario_telefonoenvios        String?     @db.VarChar(20)
  destinatario_direccionenvios       String?
  destinatario_ciudadenvios          String?     @db.VarChar(100)
  destinatario_departamentoenvios    String?     @db.VarChar(100)
  destinatario_paisenvios            String      @default("CO") @db.VarChar(5)
  destinatario_codigo_postalenvios   String?     @db.VarChar(20)
  peso_fisico_kgenvios               Decimal     @db.Decimal(8, 3)
  alto_cmenvios                      Decimal?    @db.Decimal(8, 2)
  ancho_cmenvios                     Decimal?    @db.Decimal(8, 2)
  largo_cmenvios                     Decimal?    @db.Decimal(8, 2)
  peso_volumetrico_kgenvios          Decimal?    @db.Decimal(8, 3)
  peso_tarificado_kgenvios           Decimal     @db.Decimal(8, 3)
  valor_declaradoenvios              Decimal?    @db.Decimal(18, 2)
  observacionesenvios                String?
  valor_servicioenvios               Decimal     @db.Decimal(18, 2)
  valor_estampillasenvios            Decimal     @default(0) @db.Decimal(18, 2)
  valor_seguroenvios                 Decimal     @default(0) @db.Decimal(18, 2)
  valor_certificacionenvios          Decimal     @default(0) @db.Decimal(18, 2)
  valor_totalenvios                  Decimal     @db.Decimal(18, 2)
  medio_pagoenvios                   medio_pago?
  estadoenvios                       estado_envio @default(facturado)
  numero_guia_fisicaenvios           String?     @db.VarChar(50)
  proveedor_externeenvios            String?     @db.VarChar(50)
  referencia_proveedorenvios         String?     @db.VarChar(100)
  referencia_sigmaenvios             String?     @db.VarChar(100)
  documentos_generadosenvios         Json        @default("[]") @db.JsonB
  sincronizado_sigmaenvios           Boolean     @default(false)
  created_atenvios                   DateTime    @default(now()) @db.Timestamptz(6)
  updated_atenvios                   DateTime    @default(now()) @db.Timestamptz(6)

  ventas_idventas                    Int?

  sucursal   Sucursal    @relation(fields: [sucursales_idsucursales], references: [idsucursales])
  sesionCaja SesionCaja? @relation(fields: [sesiones_caja_idsesiones_caja], references: [idsesiones_caja])
  usuario    Usuario     @relation(fields: [usuarios_idusuarios], references: [idusuarios])
  cliente    Cliente?    @relation(fields: [clientes_idclientes], references: [idclientes])
  servicio   Servicio    @relation(fields: [servicios_idservicios], references: [idservicios])
  venta      Venta?      @relation(fields: [ventas_idventas], references: [idventas])

  items      EnvioItem[]
  sacas      EnvioSaca[]
  itemMasivo EnvioMasivoItem?

  @@index([sucursales_idsucursales, created_atenvios], map: "idx_envios_sucursal_fecha")
  @@index([numero_guiaenvios], map: "idx_envios_guia")
  @@index([estadoenvios], map: "idx_envios_estado")
  @@index([ventas_idventas], map: "idx_envios_venta")
  @@map("envios")
}

model EnvioItem {
  idenvios_items              Int     @id @default(autoincrement())
  envios_idenvios             Int
  productos_idproductos       Int
  cantidadenvios_items        Int
  precio_unitarioenvios_items Decimal @db.Decimal(18, 2)
  subtotalenvios_items        Decimal @db.Decimal(18, 2)

  envio    Envio    @relation(fields: [envios_idenvios], references: [idenvios], onDelete: Cascade)
  producto Producto @relation(fields: [productos_idproductos], references: [idproductos])

  @@map("envios_items")
}

// ══════════════════════════════════════════════════════════════════════════════
// 12. FACTURACIÓN
// ══════════════════════════════════════════════════════════════════════════════

model Factura {
  idfacturas              Int            @id @default(autoincrement())
  tipofacturas            tipo_factura
  numerofacturas          String         @unique @db.VarChar(50)
  prefijofacturas         String?        @db.VarChar(10)
  referencia_idfacturas   Int
  referencia_tipofacturas String         @db.VarChar(50)
  sesiones_caja_idsesiones_caja Int?
  clientes_idclientes     Int?
  subtotalfacturas        Decimal        @db.Decimal(18, 2)
  impuestosfacturas       Decimal        @default(0) @db.Decimal(18, 2)
  totalfacturas           Decimal        @db.Decimal(18, 2)
  cufefacturas            String?        @db.VarChar(500)
  estadofacturas          estado_factura @default(emitida)
  enviada_dianfacturas    Boolean        @default(false)
  cola_dian_idfacturas    String?        @db.VarChar(100)
  created_atfacturas      DateTime       @default(now()) @db.Timestamptz(6)

  sesionCaja SesionCaja? @relation(fields: [sesiones_caja_idsesiones_caja], references: [idsesiones_caja])
  cliente    Cliente?    @relation(fields: [clientes_idclientes], references: [idclientes])

  items FacturaItem[]

  @@index([created_atfacturas], map: "idx_facturas_fecha")
  @@index([referencia_idfacturas, referencia_tipofacturas], map: "idx_facturas_ref")
  @@map("facturas")
}

model FacturaItem {
  idfacturas_items             Int     @id @default(autoincrement())
  facturas_idfacturas          Int
  descripcionfacturas_items    String  @db.VarChar(300)
  cantidadfacturas_items       Int     @default(1)
  valor_unitariofacturas_items Decimal @db.Decimal(18, 2)
  valor_totalfacturas_items    Decimal @db.Decimal(18, 2)

  factura Factura @relation(fields: [facturas_idfacturas], references: [idfacturas], onDelete: Cascade)

  @@map("facturas_items")
}

// ══════════════════════════════════════════════════════════════════════════════
// 13. INVENTARIO
// ══════════════════════════════════════════════════════════════════════════════

model InventarioSucursal {
  idinventario_sucursal              Int      @id @default(autoincrement())
  sucursales_idsucursales            Int
  productos_idproductos              Int
  cantidad_actualinventario_sucursal Int      @default(0)
  cantidad_minimainventario_sucursal Int      @default(5)
  updated_atinventario_sucursal      DateTime @default(now()) @db.Timestamptz(6)

  sucursal Sucursal @relation(fields: [sucursales_idsucursales], references: [idsucursales])
  producto Producto @relation(fields: [productos_idproductos], references: [idproductos])

  @@unique([sucursales_idsucursales, productos_idproductos])
  @@index([sucursales_idsucursales], map: "idx_inventario_sucursal")
  @@map("inventario_sucursal")
}

model MovimientoInventario {
  idmovimientos_inventario                Int                        @id @default(autoincrement())
  sucursales_idsucursales                 Int
  productos_idproductos                   Int
  tipomovimientos_inventario              tipo_movimiento_inventario
  cantidadmovimientos_inventario          Int
  cantidad_anteriormovimientos_inventario Int
