{
  "uid": "pos472-server",
  "title": "4-72 POS — Servidor",
  "tags": ["pos472", "server"],
  "timezone": "America/Bogota",
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "CPU %",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "pos472_prom" },
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 85 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "legendFormat": "CPU" }]
    },
    {
      "id": 2, "type": "stat", "title": "RAM usada %",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "pos472_prom" },
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "RAM" }]
    },
    {
      "id": 3, "type": "stat", "title": "Disco usado %",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "pos472_prom" },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "100 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} * 100)", "legendFormat": "Disco /" }]
    },
    {
      "id": 4, "type": "stat", "title": "Heap Node.js",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "pos472_prom" },
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "steps": [{ "color": "blue", "value": null }, { "color": "yellow", "value": 200000000 }, { "color": "red", "value": 400000000 }] }, "color": { "mode": "thresholds" } } },
      "targets": [{ "expr": "pos472_nodejs_heap_size_used_bytes", "legendFormat": "Heap usado" }]
    },
    {
      "id": 5, "type": "stat", "title": "Uptime servidor",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "pos472_prom" },
      "options": { "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [{ "expr": "node_time_seconds - node_boot_time_seconds", "legendFormat": "Uptime" }]
    },
    {
      "id": 6, "type": "stat", "title": "Req/s API",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "uid": "pos472_prom" },
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } } },
      "targets": [{ "expr": "sum(rate(pos472_http_requests_total[1m]))", "legendFormat": "req/s" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "CPU y RAM en el tiempo",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "pos472_prom" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)", "legendFormat": "CPU %" },
        { "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "RAM %" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Heap Node.js en el tiempo",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "uid": "pos472_prom" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "pos472_nodejs_heap_size_used_bytes", "legendFormat": "Heap usado" },
        { "expr": "pos472_nodejs_heap_size_total_bytes", "legendFormat": "Heap total" },
        { "expr": "pos472_process_resident_memory_bytes", "legendFormat": "RSS (memoria total proceso)" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Latencia API (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "pos472_prom" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 5 } } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(pos472_http_request_duration_ms_bucket[2m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(pos472_http_request_duration_ms_bucket[2m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(pos472_http_request_duration_ms_bucket[2m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "Requests por ruta",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "uid": "pos472_prom" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "sum(rate(pos472_http_requests_total[2m])) by (route, method)", "legendFormat": "{{method}} {{route}}" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Red — entrada / salida",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 7 },
      "datasource": { "uid": "pos472_prom" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2, "fillOpacity": 8 } } },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*\"}[2m])", "legendFormat": "↓ {{device}}" },
        { "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*\"}[2m])", "legendFormat": "↑ {{device}}" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Event loop lag Node.js",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 7 },
      "datasource": { "uid": "pos472_prom" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } }, "overrides": [{ "matcher": { "id": "byName", "options": "lag" }, "properties": [{ "id": "thresholds", "value": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.5 }] } }] }] },
      "targets": [
        { "expr": "pos472_nodejs_eventloop_lag_mean_seconds", "legendFormat": "lag promedio" },
        { "expr": "pos472_nodejs_eventloop_lag_p99_seconds", "legendFormat": "p99" },
        { "expr": "pos472_nodejs_eventloop_lag_max_seconds", "legendFormat": "lag máximo" }
      ]
    }
  ]
}
