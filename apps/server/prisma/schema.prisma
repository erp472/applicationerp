// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum RolUsuario {
  CAJERO
  ADMINISTRATIVO
  TESORERIA
  INVENTARIOS
  SUPERVISOR_REGIONAL
  ADMIN_NACIONAL
  ADMIN_SISTEMA
}

enum AuditAccion {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PRINT
  EXPORT
}

enum AuditResultado {
  OK
  ERROR
}

enum FeatureFlagEntorno {
  all
  dev
  staging
  prod
}

// ── Jerarquía comercial ───────────────────────────────────────────────────────

model Sucursal {
  id        String    @id @default(uuid()) @db.Uuid
  codigo    String    @unique @db.VarChar(20)
  nombre    String    @db.VarChar(120)
  ciudad    String?   @db.VarChar(80)
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  usuarios           Usuario[]
  equiposAutorizados EquipoAutorizado[]

  @@map("branches")
}

// ── Seguridad ─────────────────────────────────────────────────────────────────

model Permiso {
  id          Int       @id @default(autoincrement())
  codigo      String    @unique @db.VarChar(100)
  descripcion String?   @db.VarChar(200)
  modulo      String    @db.VarChar(50)
  deletedAt   DateTime?

  roles RolPermiso[]

  @@map("permissions")
}

model RolPermiso {
  rol       RolUsuario
  permisoId Int

  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rol, permisoId])
  @@map("role_permissions")
}

model Usuario {
  id           String     @id @default(uuid()) @db.Uuid
  nombre       String     @db.VarChar(120)
  email        String     @unique @db.VarChar(120)
  passwordHash String     @db.VarChar(255)
  rol          RolUsuario
  sucursalId   String?    @db.Uuid
  activo       Boolean    @default(true)
  ultimoLogin  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  sucursal           Sucursal?          @relation(fields: [sucursalId], references: [id])
  equiposAutorizados EquipoAutorizado[]

  @@index([email])
  @@index([rol])
  @@index([sucursalId])
  @@map("users")
}

model EquipoAutorizado {
  id         String    @id @default(uuid()) @db.Uuid
  macAddress String    @db.VarChar(17)
  sucursalId String    @db.Uuid
  usuarioId  String    @db.Uuid
  nombre     String?   @db.VarChar(120)
  activo     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Restrict)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([macAddress, usuarioId])
  @@index([usuarioId])
  @@map("authorized_devices")
}

// ── Feature flags ─────────────────────────────────────────────────────────────

model FeatureFlag {
  id          Int                @id @default(autoincrement())
  codigo      String             @unique @db.VarChar(100)
  descripcion String?            @db.VarChar(200)
  activo      Boolean            @default(false)
  entorno     FeatureFlagEntorno @default(all)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("feature_flags")
}

// ── Auditoría ─────────────────────────────────────────────────────────────────

model Auditoria {
  id            String         @id @default(uuid()) @db.Uuid
  trace_id      String?        @db.VarChar(32)
  span_id       String?        @db.VarChar(16)
  usuario_id    String?        @db.Uuid
  accion        AuditAccion
  entidad       String         @db.VarChar(64)
  entidad_id    String?        @db.VarChar(64)
  datos_antes   Json?
  datos_despues Json?
  ip_origen     String?        @db.VarChar(45)
  resultado     AuditResultado @default(OK)
  error_msg     String?
  created_at    DateTime       @default(now())

  @@index([trace_id])
  @@index([usuario_id, created_at])
  @@index([entidad, entidad_id])
  @@index([created_at])
  @@map("audit_logs")
}
