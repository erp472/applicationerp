  estadoalertas                 estado_alerta @default(pendiente)
  usuarios_idusuarios_creador   Int?
  usuarios_idusuarios_resolutor Int?
  fecha_resolucionalertas       DateTime?     @db.Timestamptz(6)
  created_atalertas             DateTime      @default(now()) @db.Timestamptz(6)

  sucursal  Sucursal? @relation(fields: [sucursales_idsucursales], references: [idsucursales])
