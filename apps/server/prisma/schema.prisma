}

model Recaudo {
  idrecaudos                            Int            @id @default(autoincrement())
  convenios_recaudo_idconvenios_recaudo Int
  sucursales_idsucursales               Int
  sesiones_caja_idsesiones_caja         Int?
  usuarios_idusuarios                   Int
  clientes_idclientes                   Int?
  referencia_pagorecaudos               String         @db.VarChar(100)
  codigo_barrasrecaudos                 String?        @db.VarChar(200)
  montorecaudos                         Decimal        @db.Decimal(18, 2)
  estadorecaudos                        estado_recaudo @default(exitoso)
  created_atrecaudos                    DateTime       @default(now()) @db.Timestamptz(6)

  convenioRecaudo ConvenioRecaudo @relation(fields: [convenios_recaudo_idconvenios_recaudo], references: [idconvenios_recaudo])
  sucursal        Sucursal        @relation(fields: [sucursales_idsucursales], references: [idsucursales])
  sesionCaja      SesionCaja?     @relation(fields: [sesiones_caja_idsesiones_caja], references: [idsesiones_caja])
  usuario         Usuario         @relation(fields: [usuarios_idusuarios], references: [idusuarios])
  cliente         Cliente?        @relation(fields: [clientes_idclientes], references: [idclientes])

  @@index([sucursales_idsucursales, created_atrecaudos], map: "idx_recaudos_sucursal_fecha")
  @@map("recaudos")
}

