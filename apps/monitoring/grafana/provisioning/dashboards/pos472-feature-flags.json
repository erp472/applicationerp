{
  "title": "POS 4-72 — Feature Flags",
  "uid": "pos472-feature-flags",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "America/Bogota",
  "tags": ["pos472", "feature-flags", "ab-test"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Features",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pos472-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "targets": [{ "refId": "A", "expr": "count(pos472_feature_flag_modo)", "legendFormat": "Total" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "En Produccion",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pos472-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [{ "refId": "A", "expr": "count(pos472_feature_flag_modo == 2) or vector(0)", "legendFormat": "Produccion" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "En Prueba A/B",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pos472-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "yellow", "value": null }] }
        }
      },
      "targets": [{ "refId": "A", "expr": "count(pos472_feature_flag_modo == 1) or vector(0)", "legendFormat": "A/B Test" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Inactivos",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "pos472-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        }
      },
      "targets": [{ "refId": "A", "expr": "count(pos472_feature_flag_modo == 0) or vector(0)", "legendFormat": "Inactivos" }]
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Historial de estado por modulo",
      "description": "Verde = Produccion   |   Amarillo = A/B Test   |   Rojo = Inactivo",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "pos472-prometheus" },
      "options": {
        "legend":    { "displayMode": "list", "placement": "bottom" },
        "rowHeight": 0.85,
        "showValue": "auto",
        "tooltip":   { "mode": "single" },
        "mergeValues": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 0, "fillOpacity": 80 },
          "mappings": [
            {
              "type": "value",
              "options": {
                "2": { "text": "Produccion", "color": "green",  "index": 0 },
                "1": { "text": "A/B Test",   "color": "yellow", "index": 1 },
                "0": { "text": "Inactivo",   "color": "red",    "index": 2 }
              }
            }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green",  "value": 2 }
            ]
          }
        }
      },
      "targets": [{
        "refId": "A",
        "expr": "pos472_feature_flag_modo",
        "legendFormat": "{{nombre}}",
        "instant": false,
        "range": true
      }]
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Estado actual de cada modulo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "pos472-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdMarkers": true,
        "showThresholdLabels": false
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "2": { "text": "PRODUCCION", "color": "green",  "index": 0 },
                "1": { "text": "A/B TEST",   "color": "yellow", "index": 1 },
                "0": { "text": "INACTIVO",   "color": "red",    "index": 2 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green",  "value": 2 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "refId": "A",
        "expr": "pos472_feature_flag_modo",
        "legendFormat": "{{nombre}}",
        "instant": true
      }]
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Distribucion por modo",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "pos472-prometheus" },
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Produccion" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "A/B Test" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "Inactivo" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [
        { "refId": "A", "expr": "count(pos472_feature_flag_modo == 2) or vector(0)", "legendFormat": "Produccion", "instant": true },
        { "refId": "B", "expr": "count(pos472_feature_flag_modo == 1) or vector(0)", "legendFormat": "A/B Test",   "instant": true },
        { "refId": "C", "expr": "count(pos472_feature_flag_modo == 0) or vector(0)", "legendFormat": "Inactivo",   "instant": true }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Detalle completo de feature flags",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "postgres", "uid": "pos472-pg" },
      "options": {
        "footer":     { "show": false },
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Estado" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "mappings", "value": [{ "type": "value", "options": {
                "PRODUCCION": { "text": "Produccion", "color": "green",  "index": 0 },
                "AB_TEST":    { "text": "A/B Test",   "color": "yellow", "index": 1 },
                "INACTIVO":   { "text": "Inactivo",   "color": "red",    "index": 2 }
              }}]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Modulo" },
            "properties": [{ "id": "custom.width", "value": 200 }]
          },
          {
            "matcher": { "id": "byName", "options": "Estado" },
            "properties": [{ "id": "custom.width", "value": 130 }]
          },
          {
            "matcher": { "id": "byName", "options": "Ultima modificacion" },
            "properties": [{ "id": "custom.width", "value": 180 }]
          }
        ]
      },
      "targets": [{
        "refId": "A",
        "rawQuery": true,
        "rawSql": "SELECT nombre AS \"Modulo\", modo AS \"Estado\", COALESCE(descripcion, '-') AS \"Descripcion\", to_char(\"updatedAt\", 'DD/MM/YYYY HH24:MI') AS \"Ultima modificacion\" FROM feature_flags ORDER BY CASE modo WHEN 'AB_TEST' THEN 0 WHEN 'PRODUCCION' THEN 1 ELSE 2 END, nombre",
        "format": "table"
      }]
    }
  ]
}
