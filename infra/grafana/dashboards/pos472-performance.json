{
  "title": "4-72 POS — Performance",
  "uid": "pos472-performance",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "America/Bogota",
  "tags": ["pos472", "performance"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests/s",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "uid": "pos472_prom" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(pos472_http_requests_total[1m]))",
        "legendFormat": "req/s"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tasa de error HTTP (%)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "uid": "pos472_prom" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
      },
      "targets": [{
        "refId": "A",
        "expr": "100 * sum(rate(pos472_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(pos472_http_requests_total[5m]))",
        "legendFormat": "% error"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Heap usado",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "uid": "pos472_prom" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "unit": "bytes" },
      "targets": [{
        "refId": "A",
        "expr": "pos472_nodejs_heap_size_used_bytes",
        "legendFormat": "heap"
      }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Event loop lag (p99)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "uid": "pos472_prom" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "unit": "ms",
        "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] }
      },
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.99, rate(pos472_nodejs_eventloop_lag_seconds_bucket[5m])) * 1000",
        "legendFormat": "p99 ms"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia HTTP (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "uid": "pos472_prom" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(pos472_http_request_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(pos472_http_request_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(pos472_http_request_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests por estado HTTP",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "uid": "pos472_prom" },
      "targets": [{
        "refId": "A",
        "expr": "sum by (status) (rate(pos472_http_requests_total[1m]))",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memoria Node.js",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "uid": "pos472_prom" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "refId": "A",
          "expr": "pos472_nodejs_heap_size_used_bytes",
          "legendFormat": "heap usado"
        },
        {
          "refId": "B",
          "expr": "pos472_nodejs_heap_size_total_bytes",
          "legendFormat": "heap total"
        },
        {
          "refId": "C",
          "expr": "pos472_process_resident_memory_bytes",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU (segundos/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "uid": "pos472_prom" },
      "targets": [{
        "refId": "A",
        "expr": "rate(pos472_process_cpu_seconds_total[1m])",
        "legendFormat": "cpu"
      }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GC — duración por tipo",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "uid": "pos472_prom" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{
        "refId": "A",
        "expr": "rate(pos472_nodejs_gc_duration_seconds_sum[1m])",
        "legendFormat": "{{kind}}"
      }]
    }
  ]
}
