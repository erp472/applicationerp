// ══════════════════════════════════════════════════════════════════════════════
// 22. ENVÍOS POSTALES MASIVOS (preporteado corporativo)
// ══════════════════════════════════════════════════════════════════════════════

model EnvioMasivo {
  idenvios_masivos                     Int                @id @default(autoincrement())
  sucursales_idsucursales              Int
  sesiones_caja_idsesiones_caja        Int?
  usuarios_idusuarios                  Int
  clientes_idclientes                  Int?
  servicios_idservicios                Int
  // Remitente compartido (null cuando cada item tiene su propio remitente)
  remitente_nombreenvios_masivos       String?            @db.VarChar(300)
  remitente_documentoenvios_masivos    String?            @db.VarChar(30)
  remitente_emailenvios_masivos        String?            @db.VarChar(200)
  remitente_telefonoenvios_masivos     String?            @db.VarChar(20)
  remitente_direccionenvios_masivos    String?
  remitente_ciudadenvios_masivos       String?            @db.VarChar(100)
  remitente_cpenvios_masivos           String?            @db.VarChar(20)
  // Totales calculados en tiempo real
  total_itemsenvios_masivos            Int                @default(0)
  total_peso_kgenvios_masivos          Decimal            @default(0) @db.Decimal(10, 3)
  total_estampillasenvios_masivos      Decimal            @default(0) @db.Decimal(18, 2)
  total_certificacionenvios_masivos    Decimal            @default(0) @db.Decimal(18, 2)
  valor_totalenvios_masivos            Decimal            @default(0) @db.Decimal(18, 2)
  estadoenvios_masivos                 estado_lote_masivo @default(borrador)
  observacionesenvios_masivos          String?
  pdf_guias_pathenvios_masivos         String?
  cobrado_atenvios_masivos             DateTime?          @db.Timestamptz(6)
  medio_pago_cobroenvios_masivos       String?            @db.VarChar(30)
  created_atenvios_masivos             DateTime           @default(now()) @db.Timestamptz(6)
  updated_atenvios_masivos             DateTime           @default(now()) @db.Timestamptz(6)

  sucursal   Sucursal    @relation(fields: [sucursales_idsucursales], references: [idsucursales])
  sesionCaja SesionCaja? @relation(fields: [sesiones_caja_idsesiones_caja], references: [idsesiones_caja])
  usuario    Usuario     @relation(fields: [usuarios_idusuarios], references: [idusuarios])
  cliente    Cliente?    @relation(fields: [clientes_idclientes], references: [idclientes])
  servicio   Servicio    @relation(fields: [servicios_idservicios], references: [idservicios])
  items      EnvioMasivoItem[]

  @@index([sucursales_idsucursales, created_atenvios_masivos], map: "idx_envios_masivos_sucursal_fecha")
  @@index([estadoenvios_masivos], map: "idx_envios_masivos_estado")
  @@map("envios_masivos")
}

model EnvioMasivoItem {
  idenvios_masivos_items                          Int     @id @default(autoincrement())
  envios_masivos_idenvios_masivos                 Int
  numero_filaenvios_masivos_items                 Int
  // Destinatario de esta fila
  destinatario_nombreenvios_masivos_items         String  @db.VarChar(300)
  destinatario_documentoenvios_masivos_items      String? @db.VarChar(30)
  destinatario_emailenvios_masivos_items          String? @db.VarChar(200)
  destinatario_telefonoenvios_masivos_items       String? @db.VarChar(20)
  destinatario_direccionenvios_masivos_items      String?
  destinatario_ciudadenvios_masivos_items         String? @db.VarChar(100)
  destinatario_paisenvios_masivos_items           String  @default("CO") @db.VarChar(5)
  destinatario_cpenvios_masivos_items             String? @db.VarChar(20)
  // Remitente propio del item (override del remitente del lote)
  remitente_nombreenvios_masivos_items            String? @db.VarChar(300)
  remitente_documentoenvios_masivos_items         String? @db.VarChar(30)
  remitente_emailenvios_masivos_items             String? @db.VarChar(200)
  remitente_telefonoenvios_masivos_items          String? @db.VarChar(20)
  remitente_direccionenvios_masivos_items         String?
  remitente_ciudadenvios_masivos_items            String? @db.VarChar(100)
  remitente_cpenvios_masivos_items                String? @db.VarChar(20)
  // Datos del envío calculados en tiempo real
  peso_fisico_kgenvios_masivos_items              Decimal @db.Decimal(8, 3)
  peso_tarificado_kgenvios_masivos_items          Decimal @db.Decimal(8, 3)
  valor_servicioenvios_masivos_items              Decimal @db.Decimal(18, 2)
  valor_estampillasenvios_masivos_items           Decimal @default(0) @db.Decimal(18, 2)
  valor_certificacionenvios_masivos_items         Decimal @default(0) @db.Decimal(18, 2)
  valor_totalenvios_masivos_items                 Decimal @db.Decimal(18, 2)
  contenidoenvios_masivos_items                   String? @db.VarChar(200)
  observacionesenvios_masivos_items               String? @db.VarChar(500)
  // Referencia al Envio creado al confirmar el lote
  envios_idenvios                                 Int?    @unique

  lote  EnvioMasivo @relation(fields: [envios_masivos_idenvios_masivos], references: [idenvios_masivos], onDelete: Cascade)
  envio Envio?       @relation(fields: [envios_idenvios], references: [idenvios])

  @@index([envios_masivos_idenvios_masivos], map: "idx_envios_masivos_items_lote")
  @@map("envios_masivos_items")
}
