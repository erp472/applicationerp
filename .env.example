# Base de datos
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/pos_472?schema=public

# JWT — mínimo 32 caracteres en producción
JWT_SECRET=cambia_esto_en_produccion_minimo_32_caracteres
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS — lista separada por comas. En dev se ignora (se permite todo).
# En producción: solo los orígenes listados aquí son permitidos.
CORS_ORIGIN=http://localhost:5173,tauri://localhost

# Redis (cache de feature flags)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cambia_esto_en_produccion

# OpenTelemetry (opcional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
